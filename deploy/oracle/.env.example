# Template for /etc/sts/sts.env on the VM.
# setup_vm.sh writes this file with a generated SECRET_KEY; add DATABASE_URL by hand.
# Never commit real values. Never paste the URL into chat or screenshots.

PORT=8000
STS_COOKIE_SECURE=1
SECRET_KEY=
DATABASE_URL=

# Not needed on the production database (accounts already exist):
# SUPERADMIN_INITIAL_PASSWORD=
# SUPERADMIN_RESET_PASSWORD=
